# Database URL — SQLite (local file)
DATABASE_URL=sqlite://contractguard.db

# Server bind address
BIND_ADDR=127.0.0.1:8080

# Workspace root — where investigation workspaces are created
WORKSPACE_ROOT=runs

# Sample project root — path to the UploadLab sample project
SAMPLE_PROJECT_ROOT=../sample_project

# CORS allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Demo mode — set to true to disable mutations
DEMO_MODE=false

# Request body limit in bytes (default: 16 MB)
# MAX_BODY_BYTES=16777216

# Test execution timeout in seconds (default: 120)
# TEST_TIMEOUT_SECS=120

# Max test output size in bytes (default: 1 MB)
# MAX_OUTPUT_BYTES=1048576
